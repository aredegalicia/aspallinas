---
const navItems = [
    { linkText: 'El bosque', href: '#el-bosque' },
    { linkText: 'Espacios', href: '#espacios' },
    { linkText: 'Residencias', href: '#residencias' },
    { linkText: 'Eventos', href: '#eventos' },
    { linkText: 'Contacto', href: '#contacto' }
];
---

<header class="site-header sticky top-0 z-40">
    <nav class="flex flex-wrap items-center gap-4 px-6 sm:px-10 py-3 max-w-[1400px] mx-auto">
        <a href="/" class="no-underline flex items-center shrink-0">
            <img src="/images/logo-lagarto.png" alt="As Palliñas" class="h-10 sm:h-12 w-auto" width="40" height="62" />
        </a>
        <ul class="flex flex-wrap gap-x-1 gap-y-1 ml-auto">
            {
                navItems.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            class="inline-block px-2 py-2 sm:px-3 text-xs sm:text-sm uppercase tracking-[0.14em] text-texto no-underline"
                        >
                            {item.linkText}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>
