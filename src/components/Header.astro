---
import Logo from '../components/Logo.astro';

const navItems = [
    { linkText: 'El bosque', href: '/#el-bosque' },
    { linkText: 'Espacios', href: '/#espacios' },
    { linkText: 'Residencias', href: '/#residencias' },
    { linkText: 'Eventos', href: '/#eventos' },
    { linkText: 'Contacto', href: '/#contacto' }
];
---

<nav class="flex flex-wrap items-center gap-4 pt-6 pb-12 sm:pt-10 sm:pb-16">
    <a href="/" class="no-underline">
        <Logo />
    </a>
    {
        !!navItems?.length && (
            <ul class="flex flex-wrap gap-x-1 gap-y-1 ml-auto">
                {navItems.map((item) => (
                    <li>
                        <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 no-underline text-texto-sec hover:text-primary">
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
</nav>
